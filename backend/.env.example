# Copia este archivo como .env y completa tus datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dev_db
DB_USER=dev
DB_PASSWORD=
DB_SCHEMA=manaco
TIMEZONE=America/La_Paz

# Clave para firmar los tokens de sesión (cámbiala por una larga y aleatoria)
JWT_SECRET=cambia-esta-clave
JWT_EXPIRE_MINUTES=480

# Direcciones del frontend que pueden llamar a la API (separadas por coma)
CORS_ORIGINS=http://localhost:4200
